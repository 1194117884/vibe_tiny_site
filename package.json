{
  "name": "tinysite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TinySite - 基于 Cloudflare Workers + R2 + D1 的静态网站部署工具",
  "scripts": {
    "dev": "wrangler dev",
    "ui:build": "tailwindcss -i ./src/ui.css -o ./public/style.css --minify",
    "deploy": "npm run ui:build && wrangler deploy",
    "db:create": "wrangler d1 create tinysite_db",
    "db:init:local": "wrangler d1 execute tinysite_db --local --file=./schema.sql && wrangler d1 execute tinysite_db --local --file=./seed.local.sql",
    "db:init:remote": "wrangler d1 execute tinysite_db --remote --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create tinysite-sites"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.0",
    "lucide": "^1.26.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.24.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
